  "claims": [
    {
      "id": "gateway_overhead",
      "text": "Built an OpenAI-compatible multi-tenant gateway (auth, rate limits, admission control, SSE streaming) over vLLM on an A100; measured p50 TTFT change vs direct vLLM: +6.3% (no_significant_difference, n=3 runs); baseline 5078 output tok/s.",
      "evidence": "benchmarks/results/baseline/20261010-092402/report.json",
      "values": {
        "ttft_delta": 0.06250134407098279,
        "verdict": "no_significant_difference",
        "n": 3,
        "tok_s": 5078.421874619901
      }
    },
    {
      "id": "routing",
      "text": "Implemented KV-cache-aware (prefix-affinity) routing; on a RAG-style prefix-heavy workload across 2 vLLM replicas (sharing one A100) p50 TTFT changed +51.7% vs round-robin (no_significant_difference).",
      "evidence": "benchmarks/results/routing/20261010-092925/report.json",
      "values": {
        "delta": 0.5172796185364111,
        "verdict": "no_significant_difference"
      }
    },
    {
      "id": "prefix_cache",
      "text": "Measured vLLM prefix caching on a prefix-heavy workload: p50 TTFT -34.2% vs caching disabled (no_significant_difference).",
      "evidence": "benchmarks/results/kv_cache/20261010-093938/report.json",
      "values": {
        "delta": -0.3419356885595729,
        "verdict": "no_significant_difference"
      }
    },
    {
      "id": "cache_isolation",
      "text": "Demonstrated a cross-tenant prefix-cache timing/side-channel (leak observed without salting: True) and closed it with per-tenant cache salts injected at the gateway (isolation enforced: True).",
      "evidence": "benchmarks/results/kv_cache/20261010-093938/report.json",
      "values": {
        "enforced": true,
        "leak": true
      }
    },
    {
      "id": "failure_recovery",
