{
  "title": "InferScale-X Serving",
  "uid": "inferscale-x",
  "schemaVersion": 39,
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"type": "timeseries", "title": "TTFT p50 / p95 (gateway)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum(rate(inferscale_ttft_seconds_bucket[1m])) by (le))", "legendFormat": "p50"},
       {"expr": "histogram_quantile(0.95, sum(rate(inferscale_ttft_seconds_bucket[1m])) by (le))", "legendFormat": "p95"}]},
    {"type": "timeseries", "title": "Request rate by status", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(inferscale_requests_total[1m])) by (status)", "legendFormat": "{{status}}"}]},
    {"type": "timeseries", "title": "Output tokens/s by tenant", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(inferscale_output_tokens_total[1m])) by (tenant)", "legendFormat": "{{tenant}}"}]},
    {"type": "timeseries", "title": "Rejections by reason", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(inferscale_rejections_total[1m])) by (reason)", "legendFormat": "{{reason}}"}]},
    {"type": "timeseries", "title": "Backend health / outstanding", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "targets": [{"expr": "inferscale_backend_healthy", "legendFormat": "healthy {{backend}}"},
                 {"expr": "inferscale_backend_outstanding", "legendFormat": "outstanding {{backend}}"}]},
    {"type": "timeseries", "title": "vLLM prefix-cache hit rate", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
     "targets": [{"expr": "rate(vllm:prefix_cache_hits_total[1m]) / rate(vllm:prefix_cache_queries_total[1m])", "legendFormat": "{{instance}}"}]},
    {"type": "timeseries", "title": "GPU util % / power W", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
     "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "util gpu{{gpu}}"},
                 {"expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "power gpu{{gpu}}"}]},
    {"type": "timeseries", "title": "vLLM waiting / running requests", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
     "targets": [{"expr": "vllm:num_requests_waiting", "legendFormat": "waiting {{instance}}"},
                 {"expr": "vllm:num_requests_running", "legendFormat": "running {{instance}}"}]}
  ]
}
